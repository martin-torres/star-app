# PocketBase data (DO NOT COMMIT - contains customer data!)
# NOTE: the local instance lives at the repo ROOT (pb_data/), not only under
# pocketbase/ - the root copy was tracked in git because the patterns below
# only matched the nested path. Keep both.
pb_data/
pb_data/**
pocketbase/pb_data/
pocketbase/pb_data/*
!pocketbase/pb_data/.gitkeep
pocketbase/*.db
pocketbase/*.db-shm
pocketbase/*.db-wal
pocketbase/pocketbase.log

# SQLite databases / WAL anywhere in the tree
*.db
*.db-shm
*.db-wal
*.sqlite
*.sqlite3

