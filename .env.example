# star-app environment template — copy to .env and fill in.
# .env is gitignored; NEVER commit real values.
#
#   cp .env.example .env
#
# Backend: self-hosted PocketBase (see db/pocketbase/deploy.sh).
# The PocketBase URL is public information (the anon key is not a secret either -
# PocketBase has no anon key; access is controlled by per-collection API rules).

VITE_POCKETBASE_URL=https://star-api.uorder.tech
# Local development: point at your own instance (this is also the client's
# built-in default when the variable is unset):
#   VITE_POCKETBASE_URL=http://127.0.0.1:8096

# App identity / demo defaults
VITE_APP_NAME=
VITE_DEMO_RESTAURANT=
VITE_MODES=to-go,dine-in,both

# ---------------------------------------------------------------------------
# DO NOT put any of the following in a VITE_-prefixed variable. Vite inlines
# every VITE_* value into the public JavaScript bundle, where anyone can read it:
#   - manager PINs          (store server-side, see db/pocketbase/pb_hooks/)
#   - Telegram bot tokens   (read server-side)
#   - payment provider secret keys
#   - the PocketBase superuser password
# ---------------------------------------------------------------------------
